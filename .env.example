# Feishu / Lark
FEISHU_APP_ID=cli_xxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxx
FEISHU_DOMAIN=feishu
FEISHU_ENCRYPT_KEY=
FEISHU_VERIFICATION_TOKEN=
# 允许在飞书中添加/删除项目的用户 open_id，多个值用逗号分隔
FEISHU_ADMIN_OPEN_IDS=

# Codex
CODEX_COMMAND=codex
CODEX_WORKING_DIRECTORY=/absolute/path/to/project
# 飞书可配置项目必须位于这些根目录中，多个绝对路径用逗号分隔
CODEX_ALLOWED_ROOTS=/absolute/path/to/projects
CODEX_MODEL=
CODEX_REASONING_EFFORT=
CODEX_REQUEST_TIMEOUT_MS=120000
CODEX_SESSION_DB_PATH=/absolute/path/to/sessions.sqlite

# Runtime
LOG_LEVEL=info
