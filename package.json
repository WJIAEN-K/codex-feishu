{
  "name": "codex-feishu-app-server",
  "version": "0.1.0",
  "description": "Feishu/Lark client for OpenAI Codex App Server",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "codex-feishu": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "codex-feishu.config.example.json"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "prepack": "npm run build && npm run typecheck && npm test",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify:app-server": "tsx tests/verify-app-server.ts"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.64.0",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^16.6.1",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "axios": "^1.18.1",
    "form-data": "^4.0.6",
    "protobufjs": "^7.6.5"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WJIAEN-K/codex-feishu.git"
  }
}
