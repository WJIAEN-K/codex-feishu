{
  "name": "codex-feishu-app-server",
  "version": "0.1.0",
  "description": "Feishu/Lark client for OpenAI Codex App Server",
  "keywords": [
    "codex",
    "openai",
    "feishu",
    "lark",
    "bot",
    "app-server",
    "cli"
  ],
  "homepage": "https://github.com/WJIAEN-K/codex-feishu#readme",
  "bugs": {
    "url": "https://github.com/WJIAEN-K/codex-feishu/issues"
  },
  "type": "module",
  "bin": {
    "codex-feishu": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "codex-feishu.config.example.json"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "dev": "tsx src/index.ts",
    "build": "npm run clean && tsc -p tsconfig.build.json && node -e \"require('node:fs').rmSync('dist/app-server/generated',{recursive:true,force:true})\"",
    "prepack": "npm run build && npm run typecheck && npm test",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate:app-server-types": "codex app-server generate-ts --out src/app-server/generated --experimental && node scripts/normalize-generated-types.mjs",
    "verify:app-server": "tsx tests/verify-app-server.ts"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.64.0",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^16.6.1",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "axios": "^1.18.1",
    "form-data": "^4.0.6",
    "protobufjs": "^7.6.5"
  },
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "packageManager": "npm@11.8.0",
  "author": "WJIAEN <k123e456@icloud.com>",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WJIAEN-K/codex-feishu.git"
  }
}
